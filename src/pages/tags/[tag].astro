---
import BaseLayout from "@layouts/BaseLayout.astro";
import FileCabinet from "@components/FileCabinet.astro";
import { getAllTags, getPostsByTag, getPublishedPosts, type BlogPost } from "@utils/posts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();

  return getAllTags(posts).map((tag) => ({
    params: { tag },
    props: { tag, posts: getPostsByTag(posts, tag) },
  }));
}

interface Props {
  tag: string;
  posts: BlogPost[];
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`标签：${tag}`} description={`Akisy 博客中带有 ${tag} 标签的文章。`}>
  <h1 class="cabinet-heading">{tag}</h1>
  <FileCabinet posts={posts} label={tag} />
</BaseLayout>
