---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getAllTags, getPostsByTag, getPublishedPosts } from "@utils/posts";
import { pathForTag } from "@utils/slug";

const posts = await getPublishedPosts();
const tags = getAllTags(posts)
  .map((tag) => ({ tag, count: getPostsByTag(posts, tag).length }))
  .sort((a, b) => b.count - a.count);
---

<BaseLayout title="标签" description="Akisy 博客的全部标签。">
  <div class="text-page">
    <h1>标签</h1>
    {
      tags.length > 0 ? (
        <ul class="plain-list">
          {tags.map(({ tag, count }) => (
            <li>
              <a href={pathForTag(tag)}>
                <span>{tag}</span>
                <span>{count}</span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty-state">还没有标签。</p>
      )
    }
  </div>
</BaseLayout>
