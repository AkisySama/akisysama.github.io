---
import BaseLayout from "@layouts/BaseLayout.astro";
import { formatRecordDate, toDateTime } from "@utils/dates";
import { getPostUrl, getPublishedPosts, type BlogPost } from "@utils/posts";

const posts = await getPublishedPosts();

const postsByYear = new Map<number, BlogPost[]>();
for (const post of posts) {
  const year = post.data.pubDate.getFullYear();
  postsByYear.set(year, [...(postsByYear.get(year) ?? []), post]);
}
---

<BaseLayout title="目录" description="Akisy 的全部博客文章。">
  <div class="text-page">
    <h1>目录</h1>
    {
      [...postsByYear].map(([year, yearPosts]) => (
        <section class="year-group">
          <h2>{year}</h2>
          <ol class="plain-list">
            {yearPosts.map((post) => (
              <li>
                <a href={getPostUrl(post)}>
                  <span>{post.data.title}</span>
                  <time datetime={toDateTime(post.data.pubDate)}>{formatRecordDate(post.data.pubDate).slice(5)}</time>
                </a>
              </li>
            ))}
          </ol>
        </section>
      ))
    }
  </div>
</BaseLayout>
