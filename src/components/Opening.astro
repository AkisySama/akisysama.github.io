---
import portrait from "../data/portrait.txt?raw";

// Made from src/assets/portrait.jpg by scripts/make-ascii-portrait.mjs.
const rows = portrait.trimEnd().split("\n");
const cols = Math.max(...rows.map((row) => row.length));
const text = rows.map((row) => row.padEnd(cols)).join("\n");
---

<!--
  The home page has two states: a cover (a portrait drawn in characters, and a line) and the
  shelf (the folders). Scrolling down raises the folders out of the line, scrolling back
  lowers them again. The folders are in the page underneath the whole time, so this is only
  ever a layer on top, and the motion itself lives in global.css. The first visit starts on
  the cover.
-->
<div class="opening" aria-hidden="true" data-opening-stage>
  <pre class="opening-portrait" style={`--portrait-cols: ${cols}; --portrait-rows: ${rows.length}`} data-portrait>{text}</pre>
  <p class="opening-hint">向下滚动</p>
</div>

<script>
  // Ignores the small drift of a resting finger on a trackpad; one wheel notch clears it.
  const WHEEL_THRESHOLD = 24;
  const WHEEL_IDLE_MS = 400;
  const WHEEL_LINE_PX = 16;
  const SWIPE_THRESHOLD = 40;
  const RAISE_KEYS = ["ArrowDown", "PageDown", "End", " ", "Enter"];
  const LOWER_KEYS = ["ArrowUp", "PageUp", "Home"];

  const root = document.documentElement;

  const stage = () => document.querySelector<HTMLElement>("[data-opening-stage]");
  const isCover = () => root.dataset.opening === "cover";
  const isRising = () => root.dataset.opening === "rising";

  // These listeners outlive page swaps, so everything is checked again when it happens.
  const gesturesOff = () =>
    !stage() ||
    matchMedia("(prefers-reduced-motion: reduce)").matches ||
    document.querySelector("[data-timeline-shell].is-open") !== null;

  const foldersAreMoving = () =>
    root.hasAttribute("data-opening") &&
    document
      .querySelector("[data-cabinet-well]")
      ?.getAnimations({ subtree: true })
      .some((animation) => animation instanceof CSSTransition && animation.playState === "running");

  const setState = (state: "rising" | "cover") => {
    if (root.dataset.opening === state) return;
    root.toggleAttribute("data-opening-turned", foldersAreMoving());
    delete root.dataset.openingIntro;
    root.dataset.opening = state;
  };

  // Scrolling back first undoes what it already moves: the page, then a sideways drawer.
  const canLower = (target: EventTarget | null) => {
    if (window.scrollY > 0) return false;
    const well = target instanceof Element ? target.closest<HTMLElement>("[data-cabinet-well]") : null;
    return !well || well.scrollLeft === 0;
  };

  let wheelTotal = 0;
  let wheelAt = 0;

  // Capture on window: this decides before the drawer's own wheel handling on document.
  window.addEventListener(
    "wheel",
    (event) => {
      if (gesturesOff() || event.ctrlKey || Math.abs(event.deltaX) > Math.abs(event.deltaY)) return;

      const delta = event.deltaMode === WheelEvent.DOM_DELTA_LINE ? event.deltaY * WHEEL_LINE_PX : event.deltaY;
      const onShelf = !isCover() && !isRising();
      if (onShelf && (delta > 0 || !canLower(event.target))) {
        wheelTotal = 0;
        return;
      }

      event.preventDefault();
      event.stopPropagation();

      if (event.timeStamp - wheelAt > WHEEL_IDLE_MS || Math.sign(wheelTotal) !== Math.sign(delta)) wheelTotal = 0;
      wheelTotal += delta;
      wheelAt = event.timeStamp;
      if (Math.abs(wheelTotal) < WHEEL_THRESHOLD) return;

      wheelTotal = 0;
      if (delta < 0) setState("cover");
      else if (isCover()) setState("rising");
    },
    { capture: true, passive: false },
  );

  // Touch screens have no wheel: a vertical swipe means the same, and sideways stays the drawer's.
  let touchStart: { x: number; y: number } | undefined;

  window.addEventListener(
    "touchstart",
    (event) => {
      const touch = event.touches.length === 1 ? event.touches[0] : undefined;
      touchStart = touch && { x: touch.clientX, y: touch.clientY };
    },
    { passive: true },
  );

  window.addEventListener(
    "touchend",
    (event) => {
      const touch = event.changedTouches[0];
      if (!touchStart || !touch || gesturesOff()) return;

      const dx = touch.clientX - touchStart.x;
      const dy = touch.clientY - touchStart.y;
      touchStart = undefined;
      if (Math.abs(dy) < SWIPE_THRESHOLD || Math.abs(dx) > Math.abs(dy)) return;

      if (dy > 0 && canLower(event.target)) setState("cover");
      else if (dy < 0 && isCover()) setState("rising");
    },
    { passive: true },
  );

  window.addEventListener("keydown", (event) => {
    if (gesturesOff() || event.metaKey || event.ctrlKey || event.altKey) return;

    if (isCover() && RAISE_KEYS.includes(event.key)) {
      event.preventDefault();
      setState("rising");
    } else if (!isCover() && LOWER_KEYS.includes(event.key) && canLower(event.target)) {
      event.preventDefault();
      setState("cover");
    }
  });

  // Tabbing lands on links the cover is hiding, so they have to come into view.
  document.addEventListener("focusin", () => {
    if (isCover()) setState("rising");
  });

  document.addEventListener("click", (event) => {
    if (isCover() && event.target instanceof Node && stage()?.contains(event.target)) setState("rising");
  });

  // The stage's delayed visibility change is timed to end with the last folder.
  document.addEventListener("transitionend", (event) => {
    if (isRising() && event.target === stage() && event.propertyName === "visibility") {
      delete root.dataset.opening;
      root.removeAttribute("data-opening-turned");
    }
  });
</script>

<script>
  /*
   * The portrait is plain text in the page; this only stirs it while the cover is showing.
   * It is typed in from the left when the cover appears, a glint crosses it now and then,
   * and the cells under the pointer scramble. Stirred characters are wrapped in <b>.
   */
  const NOISE = "/\\|-_=+*:;!^~<>";
  const FRAME_MS = 50;
  const TYPE_IN_MS = 1500;
  const GLINT_EVERY_MS = 7000;
  const GLINT_MS = 2200;
  const STIR_MS = 900;
  const ESCAPED: Record<string, string> = { "<": "&lt;", ">": "&gt;", "&": "&amp;" };

  const root = document.documentElement;
  const noise = () => {
    const ch = NOISE[Math.floor(Math.random() * NOISE.length)];
    return `<b>${ESCAPED[ch] ?? ch}</b>`;
  };

  let stop: (() => void) | undefined;

  const start = () => {
    stop?.();
    stop = undefined;

    const pre = document.querySelector<HTMLElement>("[data-portrait]");
    if (!pre) return;

    const plain = pre.textContent ?? "";
    const grid = plain.split("\n");
    const rows = grid.length;
    const cols = grid[0].length;

    let typedAt = performance.now();
    let pointer: { col: number; row: number; at: number } | undefined;
    let lastFrame = 0;
    let raf = 0;
    let timer = 0;
    let stirred = false;

    const showing = () => root.dataset.opening === "cover" || Number(getComputedStyle(pre).opacity) > 0;

    const frame = (now: number) => {
      raf = 0;
      if (document.hidden || !showing()) {
        if (stirred) pre.textContent = plain;
        stirred = false;
        return;
      }
      if (now - lastFrame < FRAME_MS) return wake();
      lastFrame = now;

      const elapsed = now - typedAt;
      const typing = elapsed < TYPE_IN_MS;
      // The edge of what has been typed, a little ragged from row to row.
      const edge = (elapsed / TYPE_IN_MS) * (cols + 16) - 8;
      const sinceGlint = (elapsed - TYPE_IN_MS) % GLINT_EVERY_MS;
      const glinting = !typing && sinceGlint < GLINT_MS;
      // The glint is a diagonal band; this is how far along the diagonal it has come.
      const glint = (sinceGlint / GLINT_MS) * (cols * 0.6 + rows) * 1.15 - 6;
      const stirring = pointer !== undefined && now - pointer.at < STIR_MS;

      let html = "";
      for (let row = 0; row < rows; row++) {
        const line = grid[row];
        for (let col = 0; col < cols; col++) {
          const ch = line[col];
          if (ch === " ") {
            html += " ";
            continue;
          }

          let scramble = false;
          if (typing) {
            scramble = col + ((row * 7 + col * 13) % 9) - 4 > edge;
          } else {
            if (glinting) scramble = Math.abs(col * 0.6 + row - glint) < 1.3 && Math.random() < 0.55;
            if (!scramble && stirring) {
              scramble = Math.abs(col - pointer!.col) < 5 && Math.abs(row - pointer!.row) < 3 && Math.random() < 0.6;
            }
          }
          html += scramble ? noise() : (ESCAPED[ch] ?? ch);
        }
        if (row < rows - 1) html += "\n";
      }
      pre.innerHTML = html;
      stirred = true;

      if (typing || glinting || stirring) wake();
      else timer = window.setTimeout(wake, GLINT_EVERY_MS - sinceGlint);
    };

    const wake = () => {
      window.clearTimeout(timer);
      raf ||= requestAnimationFrame(frame);
    };

    const retype = () => {
      typedAt = performance.now();
      wake();
    };

    const onPointerMove = (event: PointerEvent) => {
      const box = pre.getBoundingClientRect();
      pointer = {
        col: ((event.clientX - box.left) / box.width) * cols,
        row: ((event.clientY - box.top) / box.height) * rows,
        at: performance.now(),
      };
      wake();
    };

    // Coming back to the cover, the portrait waits for the folders to go down and then fades
    // in: that fade starting is the moment to type it in again.
    const onTransitionStart = (event: TransitionEvent) => {
      if (event.target === pre && event.propertyName === "opacity" && root.dataset.opening === "cover") retype();
    };

    const controller = new AbortController();
    const { signal } = controller;
    pre.addEventListener("pointermove", onPointerMove, { signal });
    pre.addEventListener("pointerleave", () => (pointer = undefined), { signal });
    pre.addEventListener("transitionstart", onTransitionStart, { signal });
    document.addEventListener("visibilitychange", wake, { signal });

    stop = () => {
      controller.abort();
      cancelAnimationFrame(raf);
      window.clearTimeout(timer);
    };

    if (root.dataset.opening === "cover") retype();
  };

  // Runs on the first load and again whenever the client router swaps this page in.
  document.addEventListener("astro:page-load", start);
</script>
