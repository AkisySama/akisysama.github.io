<section
  class="intro-sequence"
  data-intro-sequence
  aria-label="博客开场：白发女孩抱膝坐在缠满线缆的废墟机房里，她像一段不稳定的投影，不时出现信号故障"
>
  <div class="intro-stage" data-intro-stage>
    <div class="signal-scene">
      <img
        class="signal-scene-frame"
        src="/images/intro/signal-girl.webp"
        alt="白发女孩抱膝坐在缠满线缆的废墟机房里"
        width="1672"
        height="941"
        loading="eager"
        fetchpriority="high"
      />
      <video
        class="signal-scene-frame signal-scene-video"
        src="/videos/intro/signal-girl-glitch.mp4"
        poster="/images/intro/signal-girl.webp"
        width="1672"
        height="940"
        muted
        loop
        playsinline
        preload="auto"
        disablepictureinpicture
        aria-hidden="true"
        data-signal-video
      ></video>
    </div>
    <button
      class="intro-enter"
      type="button"
      data-intro-enter
      aria-label="进入博客"
    ></button>
    <p class="intro-hint" aria-hidden="true">
      <span class="intro-hint-wide">CLICK SCREEN · SCROLL DOWN</span>
      <span class="intro-hint-narrow">TAP · SWIPE UP</span>
    </p>
  </div>
</section>

<script is:inline>
  const setupIntro = () => {
    const intro = document.querySelector("[data-intro-sequence]");
    if (!(intro instanceof HTMLElement) || intro.dataset.bound === "true") return;

    intro.dataset.bound = "true";

    const root = document.documentElement;
    if (root.dataset.intro !== "pending") {
      root.dataset.blogEntered = "true";
      intro.hidden = true;
      return;
    }

    const signalVideo = intro.querySelector("[data-signal-video]");
    const enterButton = intro.querySelector("[data-intro-enter]");

    const motionQuery = matchMedia("(prefers-reduced-motion: reduce)");
    const entryController = new AbortController();
    let enterScrollTimer = 0;
    let setupFrame = 0;
    let visibilityObserver = null;
    let reducedMotion = motionQuery.matches;
    let introVisible = true;
    let documentVisible = !document.hidden;
    let touchStartY = 0;
    let disposed = false;

    root.dataset.intro = "playing";
    window.scrollTo({ top: 0, left: 0, behavior: "auto" });

    // The glitch loop only runs while the intro is on screen; reduced motion
    // keeps the still image instead.
    const syncVideo = () => {
      if (!disposed && !reducedMotion && introVisible && documentVisible) {
        signalVideo.play().then(
          () => intro.classList.add("is-signal-playing"),
          () => intro.classList.remove("is-signal-playing"),
        );
      } else {
        signalVideo.pause();
        if (reducedMotion) intro.classList.remove("is-signal-playing");
      }
    };

    const syncBlogEntered = () => {
      const blogEntered = window.scrollY >= intro.offsetHeight * 0.55;
      root.dataset.blogEntered = blogEntered ? "true" : "false";
    };

    const isIntroEntryActive = () =>
      window.scrollY < intro.offsetHeight * 0.6;

    const enterBlog = () => {
      if (enterScrollTimer) return;

      enterScrollTimer = window.setTimeout(
        () => {
          enterScrollTimer = 0;
          if (window.scrollY >= intro.offsetHeight) return;

          window.scrollTo({
            top: intro.offsetHeight,
            behavior: reducedMotion ? "auto" : "smooth",
          });
        },
        reducedMotion ? 0 : 140,
      );
    };

    const handleWheel = (event) => {
      if (event.deltaY <= 5 || !isIntroEntryActive()) return;
      event.preventDefault();
      enterBlog();
    };

    const handleTouchStart = (event) => {
      touchStartY = event.changedTouches[0].clientY;
    };

    const handleTouchEnd = (event) => {
      const touchEndY = event.changedTouches[0].clientY;
      if (touchStartY - touchEndY >= 34 && isIntroEntryActive()) enterBlog();
    };

    const handleKeydown = (event) => {
      const interactiveTarget =
        event.target instanceof Element
          ? event.target.closest("a, button, input, textarea, select, [contenteditable='true']")
          : null;

      if (interactiveTarget && interactiveTarget !== enterButton) return;
      if (!["ArrowDown", "PageDown", " ", "Enter"].includes(event.key)) return;
      if (!isIntroEntryActive()) return;
      event.preventDefault();
      enterBlog();
    };

    const handleVisibilityChange = () => {
      documentVisible = !document.hidden;
      syncVideo();
    };

    const handleMotionChange = (event) => {
      reducedMotion = event.matches;
      syncVideo();
    };

    const cleanup = () => {
      disposed = true;
      entryController.abort();
      window.clearTimeout(enterScrollTimer);
      window.cancelAnimationFrame(setupFrame);
      signalVideo.pause();
      visibilityObserver?.disconnect();
      motionQuery.removeEventListener("change", handleMotionChange);
      document.removeEventListener("visibilitychange", handleVisibilityChange);
    };

    enterButton.addEventListener("click", enterBlog, { signal: entryController.signal });
    window.addEventListener("wheel", handleWheel, {
      passive: false,
      signal: entryController.signal,
    });
    window.addEventListener("touchstart", handleTouchStart, {
      passive: true,
      signal: entryController.signal,
    });
    window.addEventListener("touchend", handleTouchEnd, {
      passive: true,
      signal: entryController.signal,
    });
    window.addEventListener("keydown", handleKeydown, { signal: entryController.signal });
    window.addEventListener("scroll", syncBlogEntered, {
      passive: true,
      signal: entryController.signal,
    });
    window.addEventListener("resize", syncBlogEntered, {
      passive: true,
      signal: entryController.signal,
    });
    motionQuery.addEventListener("change", handleMotionChange);
    document.addEventListener("visibilitychange", handleVisibilityChange);
    document.addEventListener("astro:before-swap", cleanup, { once: true });

    if ("IntersectionObserver" in window) {
      visibilityObserver = new IntersectionObserver(
        ([entry]) => {
          introVisible = entry.isIntersecting;
          syncVideo();
        },
        { threshold: 0.01 },
      );
      visibilityObserver.observe(intro);
    }

    setupFrame = requestAnimationFrame(() => {
      intro.classList.add("is-ready");
      root.dataset.intro = "complete";
      syncBlogEntered();
      syncVideo();
    });
  };

  document.addEventListener("astro:page-load", setupIntro);
  setupIntro();
</script>

<style>
  :global(html[data-page="home"][data-intro="seen"]) .intro-sequence {
    display: none;
  }

  .intro-sequence {
    position: relative;
    height: 100svh;
    min-height: 560px;
    overflow: hidden;
    background: #c7cdc6;
    color: #26302e;
  }

  .intro-stage,
  .signal-scene,
  .signal-scene-frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .intro-stage {
    overflow: hidden;
    background: #c7cdc6;
  }

  .signal-scene {
    /* Keeps the girl in view as narrower screens crop the 16:9 frame. */
    --scene-position-x: 40%;
    opacity: 0;
    transform: scale(1.015);
    transition:
      opacity 900ms ease,
      transform 1800ms cubic-bezier(0.2, 0.72, 0.22, 1);
  }

  .is-ready .signal-scene {
    opacity: 1;
    transform: scale(1);
  }

  .signal-scene-frame {
    max-width: none;
    object-fit: cover;
    object-position: var(--scene-position-x) center;
    user-select: none;
    -webkit-user-drag: none;
    pointer-events: none;
  }

  /* The video only covers the still once it is actually playing. */
  .signal-scene-video {
    opacity: 0;
  }

  .is-signal-playing .signal-scene-video {
    opacity: 1;
  }

  .intro-enter {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    border: 0;
    padding: 0;
    background: transparent;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  .intro-enter:focus-visible {
    outline: 2px solid rgb(38 48 46 / 55%);
    outline-offset: -10px;
  }

  .intro-hint {
    position: absolute;
    bottom: 24px;
    left: 50%;
    z-index: 2;
    margin: 0;
    padding: 0.5em 0.9em 0.5em 1.1em;
    border-radius: 2px;
    background: rgb(232 236 230 / 62%);
    backdrop-filter: blur(3px);
    color: rgb(30 38 36 / 82%);
    font-family: var(--font-mono);
    font-size: 0.47rem;
    letter-spacing: 0.2em;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transform: translateX(-50%);
    transition: opacity 700ms ease 900ms;
  }

  .is-ready .intro-hint {
    opacity: 1;
  }

  .intro-hint-narrow {
    display: none;
  }

  @media (max-width: 720px) {
    .intro-hint {
      bottom: max(20px, env(safe-area-inset-bottom));
    }
  }

  @media (max-aspect-ratio: 1249 / 1000) {
    .signal-scene {
      --scene-position-x: 38%;
    }

    .intro-hint-wide {
      display: none;
    }

    .intro-hint-narrow {
      display: inline;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .signal-scene,
    .intro-hint {
      transition: none;
    }

    .signal-scene {
      opacity: 1;
      transform: none;
    }

    .intro-hint {
      opacity: 1;
    }
  }
</style>
