<section
  class="intro-sequence"
  data-intro-sequence
  aria-label="博客开场：下着雨的蓝色夜城前，白发像素女孩抱膝坐在床上"
>
  <div class="intro-stage" data-intro-stage>
    <audio
      src="/audio/rain-window-loop.m4a"
      preload="auto"
      loop
      data-rain-audio
      aria-hidden="true"
    ></audio>

    <div class="pixel-scene">
      <img
        class="pixel-scene-frame pixel-scene-open"
        src="/images/intro/pixel-room-side-enter.webp"
        alt="蓝色霓虹夜景中，白发像素女孩抱膝坐在床上望向窗外，窗前有一只猫，右下角笔记本屏幕显示“进入”"
        width="1672"
        height="941"
        loading="eager"
        fetchpriority="high"
      />
      <canvas
        class="pixel-rain"
        width="1672"
        height="941"
        data-pixel-rain
        aria-hidden="true"
      ></canvas>
      <img
        class="pixel-scene-frame pixel-scene-blink"
        src="/images/intro/pixel-room-side-blink.webp"
        alt=""
        width="1672"
        height="941"
        loading="eager"
        aria-hidden="true"
        data-blink-frame
      />
      <div class="scene-coordinate-space">
        <button
          class="intro-enter"
          type="button"
          data-intro-enter
          aria-label="进入博客"
        ></button>

        <button
          class="intro-sound intro-sound-clock"
          type="button"
          data-rain-sound
          data-sound-state="wait"
          aria-label="播放雨声"
          aria-pressed="false"
        >
          <span class="intro-sound-screen" aria-hidden="true">
            <span>RAIN:</span>
            <span data-rain-sound-state>TAP</span>
          </span>
        </button>
      </div>
    </div>

    <div class="intro-chrome">
      <button
        class="intro-sound intro-sound-mobile"
        type="button"
        data-rain-sound
        data-sound-state="wait"
        aria-label="播放雨声"
        aria-pressed="false"
      >
        <img
          class="intro-sound-device"
          src="/images/intro/rain-clock-device.webp"
          alt=""
          width="144"
          height="80"
          aria-hidden="true"
        />
        <span class="intro-sound-screen" aria-hidden="true">
          <span>RAIN:</span>
          <span data-rain-sound-state>TAP</span>
        </span>
      </button>

      <p class="intro-hint" aria-hidden="true">
        <span class="intro-hint-wide">CLICK SCREEN · SCROLL DOWN</span>
        <span class="intro-hint-narrow">SWIPE UP · ENTER</span>
      </p>
    </div>
  </div>
</section>

<script is:inline>
  const setupIntro = () => {
    const intro = document.querySelector("[data-intro-sequence]");
    if (!(intro instanceof HTMLElement) || intro.dataset.bound === "true") return;

    intro.dataset.bound = "true";

    const root = document.documentElement;
    if (root.dataset.intro !== "pending") {
      root.dataset.blogEntered = "true";
      intro.hidden = true;
      return;
    }

    const stage = intro.querySelector("[data-intro-stage]");
    const blinkFrame = intro.querySelector("[data-blink-frame]");
    const rainCanvas = intro.querySelector("[data-pixel-rain]");
    const rainAudio = intro.querySelector("[data-rain-audio]");
    const soundButtons = Array.from(intro.querySelectorAll("[data-rain-sound]"));
    const soundStates = Array.from(
      intro.querySelectorAll("[data-rain-sound-state]"),
    );
    const enterButton = intro.querySelector("[data-intro-enter]");

    if (
      !(stage instanceof HTMLElement) ||
      !(blinkFrame instanceof HTMLImageElement) ||
      !(rainCanvas instanceof HTMLCanvasElement) ||
      !(rainAudio instanceof HTMLAudioElement) ||
      soundButtons.length !== 2 ||
      soundStates.length !== soundButtons.length ||
      !soundButtons.every((button) => button instanceof HTMLButtonElement) ||
      !soundStates.every((state) => state instanceof HTMLElement) ||
      !(enterButton instanceof HTMLButtonElement)
    ) {
      root.dataset.intro = "seen";
      return;
    }

    const motionQuery = matchMedia("(prefers-reduced-motion: reduce)");
    const mobileAudioQuery = matchMedia("(max-width: 720px), (pointer: coarse)");
    const entryController = new AbortController();
    const rainContext = rainCanvas.getContext("2d", { alpha: true });
    const rainFrameInterval = 1000 / 16;
    const rainGlassMask = new Path2D();
    const rainForegroundMask = new Path2D();
    const rainColors = [
      "rgb(96 216 255 / 34%)",
      "rgb(126 162 255 / 28%)",
      "rgb(58 145 255 / 24%)",
    ];
    let blinkScheduleTimer = 0;
    let blinkReleaseTimer = 0;
    let enterScrollTimer = 0;
    let soundFadeFrame = 0;
    let soundPlayAttempt = 0;
    let setupFrame = 0;
    let rainAnimationFrame = 0;
    let rainLastFrame = 0;
    let rainSeed = 0xa51c9;
    let rainObserver = null;
    let reducedMotion = motionQuery.matches;
    let introVisible = true;
    let introAudible = true;
    let documentVisible = !document.hidden;
    let soundDesired = true;
    let soundStatus = "wait";
    let soundUnlocked = false;
    let touchStartY = 0;
    let disposed = false;

    const addPolygon = (path, points) => {
      const [first, ...rest] = points;
      path.moveTo(first[0], first[1]);
      for (const [x, y] of rest) path.lineTo(x, y);
      path.closePath();
    };

    // Rain is first clipped to the glass, then erased behind foreground
    // silhouettes. Keeping these paths separate prevents an even-odd mask
    // from turning the parts of the girl or cat outside the glass into rain.
    addPolygon(rainGlassMask, [[751, 55], [976, 34], [976, 632], [751, 632]]);
    addPolygon(rainGlassMask, [[1002, 33], [1240, 12], [1240, 632], [1002, 632]]);
    addPolygon(rainGlassMask, [
      [1272, 3],
      [1590, 3],
      [1590, 412],
      [1513, 412],
      [1513, 487],
      [1466, 487],
      [1466, 632],
      [1272, 632],
    ]);
    addPolygon(rainForegroundMask, [
      [581, 274],
      [621, 269],
      [663, 275],
      [702, 290],
      [731, 317],
      [750, 349],
      [757, 375],
      [750, 386],
      [737, 390],
      [731, 397],
      [741, 403],
      [740, 421],
      [729, 440],
      [708, 451],
      [746, 465],
      [778, 482],
      [806, 496],
      [822, 493],
      [843, 501],
      [860, 518],
      [868, 541],
      [867, 559],
      [856, 576],
      [873, 602],
      [890, 646],
      [912, 694],
      [943, 733],
      [976, 753],
      [1009, 765],
      [1007, 776],
      [985, 782],
      [947, 783],
      [916, 780],
      [868, 773],
      [704, 773],
      [568, 771],
      [567, 710],
      [552, 675],
      [531, 647],
      [500, 631],
      [480, 612],
      [464, 585],
      [465, 553],
      [476, 523],
      [483, 486],
      [489, 455],
      [504, 428],
      [517, 395],
      [524, 356],
      [539, 318],
      [558, 291],
    ]);
    addPolygon(rainForegroundMask, [
      [1056, 712],
      [1065, 690],
      [1072, 661],
      [1073, 618],
      [1080, 614],
      [1080, 586],
      [1097, 599],
      [1113, 596],
      [1127, 582],
      [1130, 616],
      [1141, 630],
      [1168, 638],
      [1186, 649],
      [1196, 668],
      [1197, 701],
      [1204, 685],
      [1212, 677],
      [1222, 677],
      [1229, 684],
      [1228, 693],
      [1220, 699],
      [1230, 705],
      [1230, 714],
      [1218, 719],
      [1198, 715],
      [1169, 714],
      [1136, 714],
      [1100, 715],
      [1071, 715],
    ]);

    const randomRain = () => {
      rainSeed = (rainSeed * 1664525 + 1013904223) >>> 0;
      return rainSeed / 4294967296;
    };

    const resetDrop = (drop, initial = false) => {
      drop.x = 716 + randomRain() * 872;
      drop.y = initial ? randomRain() * 680 - 40 : -24 - randomRain() * 180;
      drop.length = 16 + Math.floor(randomRain() * 5) * 4;
      drop.width = randomRain() > 0.78 ? 4 : 3;
      drop.speed = 13 + Math.floor(randomRain() * 5) * 3;
      drop.drift = randomRain() > 0.22 ? -1 : 0;
      drop.color = rainColors[Math.floor(randomRain() * rainColors.length)];
      return drop;
    };

    const rainDrops = Array.from({ length: 104 }, () => resetDrop({}, true));

    const drawRain = (advance = true) => {
      if (!rainContext) return;

      rainContext.setTransform(1, 0, 0, 1, 0, 0);
      rainContext.clearRect(0, 0, rainCanvas.width, rainCanvas.height);
      rainContext.save();
      rainContext.clip(rainGlassMask);
      rainContext.globalCompositeOperation = "screen";
      rainContext.imageSmoothingEnabled = false;

      for (const drop of rainDrops) {
        rainContext.fillStyle = drop.color;

        for (let offset = 0; offset < drop.length; offset += 4) {
          rainContext.fillRect(
            Math.round(drop.x - offset * 0.22),
            Math.round(drop.y + offset),
            drop.width,
            Math.min(4, drop.length - offset),
          );
        }

        if (!advance) continue;
        drop.x += drop.drift;
        drop.y += drop.speed;
        if (drop.y > 664) resetDrop(drop);
      }

      rainContext.restore();
      rainContext.save();
      rainContext.globalCompositeOperation = "destination-out";
      rainContext.fillStyle = "#000";
      rainContext.fill(rainForegroundMask);
      rainContext.restore();
      rainCanvas.dataset.rainFrame = String(Number(rainCanvas.dataset.rainFrame ?? 0) + 1);
    };

    const shouldAnimateRain = () =>
      !disposed && !reducedMotion && introVisible && documentVisible;

    const drawRainFrame = (timestamp) => {
      rainAnimationFrame = 0;
      if (!shouldAnimateRain()) return;

      if (timestamp - rainLastFrame >= rainFrameInterval) {
        rainLastFrame = timestamp - ((timestamp - rainLastFrame) % rainFrameInterval);
        drawRain(true);
      }

      rainAnimationFrame = requestAnimationFrame(drawRainFrame);
    };

    const stopRain = () => {
      window.cancelAnimationFrame(rainAnimationFrame);
      rainAnimationFrame = 0;
    };

    const startRain = () => {
      if (!rainContext || rainAnimationFrame || !shouldAnimateRain()) return;
      rainLastFrame = 0;
      rainAnimationFrame = requestAnimationFrame(drawRainFrame);
    };

    root.dataset.intro = "playing";
    window.scrollTo({ top: 0, left: 0, behavior: "auto" });

    const setRainSoundState = (state) => {
      soundStatus = state;
      const stateText = state === "on" ? "ON" : state === "off" ? "OFF" : "TAP";

      const isOn = state === "on";
      const label =
        isOn ? "关闭雨声" : state === "wait" ? "播放雨声" : "开启雨声";

      soundButtons.forEach((button) => {
        button.dataset.soundState = state;
        button.setAttribute("aria-pressed", String(isOn));
        button.setAttribute("aria-label", label);
      });
      soundStates.forEach((stateNode) => {
        stateNode.textContent = stateText;
      });
    };

    const soundControlAvailable = () =>
      soundButtons.some((button) => button.getClientRects().length > 0);

    const fadeRainSound = (targetVolume, pauseAtEnd = false) => {
      window.cancelAnimationFrame(soundFadeFrame);
      soundFadeFrame = 0;

      const startVolume = rainAudio.volume;
      const startedAt = performance.now();
      const duration = targetVolume > startVolume ? 520 : 360;

      const step = (timestamp) => {
        if (disposed) return;

        const progress = Math.min(1, (timestamp - startedAt) / duration);
        const eased = 1 - (1 - progress) ** 3;
        rainAudio.volume =
          startVolume + (targetVolume - startVolume) * eased;

        if (progress < 1) {
          soundFadeFrame = requestAnimationFrame(step);
          return;
        }

        soundFadeFrame = 0;
        if (pauseAtEnd) rainAudio.pause();
      };

      soundFadeFrame = requestAnimationFrame(step);
    };

    const shouldPlayRainSound = () =>
      soundDesired &&
      soundControlAvailable() &&
      introAudible &&
      documentVisible &&
      !disposed;

    const pauseRainSound = (immediate = false) => {
      soundPlayAttempt += 1;
      window.cancelAnimationFrame(soundFadeFrame);
      soundFadeFrame = 0;

      if (immediate) {
        rainAudio.volume = 0;
        rainAudio.pause();
        return;
      }

      fadeRainSound(0, true);
    };

    const startRainSound = async () => {
      if (!shouldPlayRainSound()) return;

      const playAttempt = ++soundPlayAttempt;

      try {
        if (rainAudio.paused) {
          rainAudio.volume = Math.max(0.01, Math.min(rainAudio.volume, 0.04));
          await rainAudio.play();
        }

        if (playAttempt !== soundPlayAttempt) {
          if (!shouldPlayRainSound()) pauseRainSound(true);
          return;
        }

        soundUnlocked = true;
        if (!shouldPlayRainSound()) {
          pauseRainSound(true);
          return;
        }

        setRainSoundState("on");
        fadeRainSound(mobileAudioQuery.matches ? 0.08 : 0.171);
      } catch {
        if (playAttempt === soundPlayAttempt && shouldPlayRainSound()) {
          setRainSoundState("wait");
        }
      }
    };

    const syncRainSound = () => {
      if (shouldPlayRainSound() && soundUnlocked) {
        void startRainSound();
      } else if (
        !soundControlAvailable() ||
        !introAudible ||
        !documentVisible ||
        !soundDesired
      ) {
        pauseRainSound(!documentVisible);
      }
    };

    const handleRainSoundToggle = () => {
      if (soundStatus === "on") {
        soundDesired = false;
        setRainSoundState("off");
        pauseRainSound();
        return;
      }

      soundDesired = true;
      void startRainSound();
    };

    const handleRainSoundUnlock = (event) => {
      const target = event.target;
      if (
        target instanceof Node &&
        soundButtons.some((button) => button.contains(target))
      ) {
        return;
      }
      if (soundDesired && soundStatus === "wait") {
        void startRainSound();
      }
    };

    const resetBlink = () => {
      window.clearTimeout(blinkScheduleTimer);
      window.clearTimeout(blinkReleaseTimer);
      blinkFrame.classList.remove("is-blinking");
      blinkFrame.dataset.blinkState = "open";
    };

    const blink = () => {
      if (reducedMotion || disposed) return;

      window.clearTimeout(blinkReleaseTimer);
      blinkFrame.classList.add("is-blinking");
      blinkFrame.dataset.blinkState = "closed";

      blinkReleaseTimer = window.setTimeout(() => {
        blinkFrame.classList.remove("is-blinking");
        blinkFrame.dataset.blinkState = "open";
      }, 165);
    };

    const scheduleBlink = (initial = false) => {
      if (reducedMotion || disposed) return;
      const delay = initial
        ? 5000 + Math.random() * 3000
        : 9000 + Math.random() * 6000;

      window.clearTimeout(blinkScheduleTimer);
      blinkScheduleTimer = window.setTimeout(() => {
        blink();
        scheduleBlink(false);
      }, delay);
    };

    const syncBlogEntered = () => {
      const blogEntered = window.scrollY >= intro.offsetHeight * 0.55;
      root.dataset.blogEntered = blogEntered ? "true" : "false";
    };

    const isIntroEntryActive = () =>
      window.scrollY < intro.offsetHeight * 0.6;

    const enterBlog = () => {
      if (enterScrollTimer) return;

      enterScrollTimer = window.setTimeout(
        () => {
          enterScrollTimer = 0;
          if (window.scrollY >= intro.offsetHeight) return;

          window.scrollTo({
            top: intro.offsetHeight,
            behavior: reducedMotion ? "auto" : "smooth",
          });
        },
        reducedMotion ? 0 : 140,
      );
    };

    const handleWheel = (event) => {
      if (event.deltaY <= 5 || !isIntroEntryActive()) return;
      event.preventDefault();
      enterBlog();
    };

    const handleTouchStart = (event) => {
      touchStartY = event.changedTouches[0]?.clientY ?? 0;
    };

    const handleTouchEnd = (event) => {
      const touchEndY = event.changedTouches[0]?.clientY ?? touchStartY;
      if (touchStartY - touchEndY >= 34 && isIntroEntryActive()) enterBlog();
    };

    const handleKeydown = (event) => {
      const interactiveTarget =
        event.target instanceof Element
          ? event.target.closest("a, button, input, textarea, select, [contenteditable='true']")
          : null;

      if (interactiveTarget && interactiveTarget !== enterButton) return;
      if (!["ArrowDown", "PageDown", " ", "Enter"].includes(event.key)) return;
      if (!isIntroEntryActive()) return;
      event.preventDefault();
      enterBlog();
    };

    const handleScroll = () => {
      syncBlogEntered();
    };

    const handleVisibilityChange = () => {
      documentVisible = !document.hidden;
      if (documentVisible) {
        startRain();
        syncRainSound();
      } else {
        stopRain();
        pauseRainSound(true);
      }
    };

    const handleMotionChange = (event) => {
      reducedMotion = event.matches;
      resetBlink();
      stopRain();
      drawRain(false);

      if (!reducedMotion) {
        startRain();
        scheduleBlink(true);
      }
    };

    const cleanup = () => {
      disposed = true;
      entryController.abort();
      resetBlink();
      window.clearTimeout(enterScrollTimer);
      window.cancelAnimationFrame(soundFadeFrame);
      window.cancelAnimationFrame(setupFrame);
      stopRain();
      rainAudio.pause();
      rainAudio.currentTime = 0;
      rainObserver?.disconnect();
      motionQuery.removeEventListener("change", handleMotionChange);
      document.removeEventListener("visibilitychange", handleVisibilityChange);
    };

    soundButtons.forEach((button) => {
      button.addEventListener("click", handleRainSoundToggle, {
        signal: entryController.signal,
      });
    });
    window.addEventListener("pointerdown", handleRainSoundUnlock, {
      capture: true,
      signal: entryController.signal,
    });
    window.addEventListener("click", handleRainSoundUnlock, {
      capture: true,
      signal: entryController.signal,
    });
    window.addEventListener("keydown", handleRainSoundUnlock, {
      capture: true,
      signal: entryController.signal,
    });
    enterButton.addEventListener("click", enterBlog, { signal: entryController.signal });
    window.addEventListener("wheel", handleWheel, {
      passive: false,
      signal: entryController.signal,
    });
    window.addEventListener("touchstart", handleTouchStart, {
      passive: true,
      signal: entryController.signal,
    });
    window.addEventListener("touchend", handleTouchEnd, {
      passive: true,
      signal: entryController.signal,
    });
    window.addEventListener("keydown", handleKeydown, { signal: entryController.signal });
    window.addEventListener("scroll", handleScroll, {
      passive: true,
      signal: entryController.signal,
    });
    window.addEventListener("resize", syncRainSound, {
      passive: true,
      signal: entryController.signal,
    });
    window.addEventListener("resize", syncBlogEntered, {
      passive: true,
      signal: entryController.signal,
    });
    motionQuery.addEventListener("change", handleMotionChange);
    document.addEventListener("visibilitychange", handleVisibilityChange);
    document.addEventListener("astro:before-swap", cleanup, { once: true });

    if ("IntersectionObserver" in window) {
      rainObserver = new IntersectionObserver(
        ([entry]) => {
          introVisible = entry?.isIntersecting ?? true;
          introAudible = (entry?.intersectionRatio ?? 1) >= 0.18;
          if (introVisible) {
            startRain();
          } else {
            stopRain();
          }
          syncRainSound();
        },
        { threshold: [0.01, 0.18] },
      );
      rainObserver.observe(intro);
    }

    setupFrame = requestAnimationFrame(() => {
      intro.classList.add("is-ready");
      root.dataset.intro = "complete";
      blinkFrame.dataset.blinkState = "open";
      drawRain(!reducedMotion);
      startRain();
      setRainSoundState("wait");
      syncBlogEntered();
      void startRainSound();

      const blinkReady =
        typeof blinkFrame.decode === "function" ? blinkFrame.decode() : Promise.resolve();
      blinkReady.catch(() => {}).then(() => scheduleBlink(true));
    });
  };

  document.addEventListener("astro:page-load", setupIntro);
  setupIntro();
</script>

<style>
  :global(html[data-page="home"][data-intro="seen"]) .intro-sequence {
    display: none;
  }

  .intro-sequence {
    position: relative;
    height: 100svh;
    min-height: 560px;
    overflow: hidden;
    background: #020616;
    color: #eef3ff;
  }

  .intro-stage,
  .pixel-scene,
  .pixel-scene-frame,
  .pixel-rain {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .intro-stage {
    overflow: hidden;
    background: #020616;
  }

  .pixel-scene {
    --scene-position-x: 50%;
    --scene-translate-x: -50%;
    cursor: default;
    opacity: 0;
    transform: scale(1.015);
    transition:
      opacity 900ms ease,
      transform 1800ms cubic-bezier(0.2, 0.72, 0.22, 1);
  }

  .is-ready .pixel-scene {
    opacity: 1;
    transform: scale(1);
  }

  .pixel-scene-frame,
  .pixel-rain {
    max-width: none;
    object-fit: cover;
    object-position: var(--scene-position-x) center;
    image-rendering: pixelated;
    user-select: none;
    -webkit-user-drag: none;
  }

  .pixel-scene-open {
    z-index: 0;
  }

  .pixel-rain {
    z-index: 1;
    display: block;
    pointer-events: none;
  }

  .pixel-scene-blink {
    z-index: 2;
    opacity: 0;
    pointer-events: none;
  }

  .pixel-scene-blink.is-blinking {
    opacity: 1;
  }

  .scene-coordinate-space {
    position: absolute;
    top: 50%;
    left: var(--scene-position-x);
    z-index: 3;
    width: max(100%, calc(100svh * 1.7768331562));
    height: max(100%, calc(100vw * 0.5627990431));
    container-type: size;
    pointer-events: none;
    transform: translate(var(--scene-translate-x), -50%);
  }

  .intro-chrome {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  .intro-sound {
    position: absolute;
    border: 0;
    padding: 0;
    background: transparent;
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: opacity 420ms steps(3, end) 620ms;
  }

  .intro-sound-clock {
    top: 43.7832%;
    left: 90.4306%;
    width: 8.6124%;
    height: 8.5016%;
    clip-path: polygon(5.5% 3%, 93.5% 3%, 100% 15%, 100% 88%, 94% 98%, 5% 98%, 0 88%, 0 15%);
  }

  .intro-sound-mobile {
    display: none;
  }

  .intro-sound-device {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: fill;
    image-rendering: pixelated;
    pointer-events: none;
    user-select: none;
    -webkit-user-drag: none;
  }

  .intro-sound-screen {
    position: absolute;
    top: 22.5%;
    left: 11.1111%;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 77.7778%;
    height: 61.25%;
    overflow: hidden;
    background: #010a36;
    color: rgb(71 178 255 / 84%);
    font-family: var(--font-pixel);
    font-size: clamp(6px, 1.05cqh, 10px);
    line-height: 1;
    letter-spacing: 0.04em;
    white-space: nowrap;
    text-shadow: 0 0 0.45em rgb(28 185 255 / 78%);
    clip-path: polygon(4% 0, 96% 0, 100% 10%, 100% 90%, 96% 100%, 4% 100%, 0 90%, 0 10%);
    box-shadow: inset 0 0 0 1px rgb(45 94 232 / 36%);
    image-rendering: pixelated;
    transition:
      background 120ms steps(2, end),
      color 120ms steps(2, end),
      filter 120ms steps(2, end),
