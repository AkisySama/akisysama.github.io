---
import { BookOpen, Globe } from "@lucide/astro";
import { getAllTags, getPublishedPosts } from "@utils/posts";

const socialLinks = [
  { href: "https://github.com/akisysama", label: "GitHub", icon: Globe, external: true },
  { href: "/posts/", label: "文章", icon: BookOpen },
];

const posts = await getPublishedPosts();
const siteStartedOn = "2024-03-26";
const siteStartedAt = Date.UTC(2024, 2, 26);
const daysOnline = Math.max(1, Math.floor((Date.now() - siteStartedAt) / 86_400_000) + 1);
const latestUpdate = posts.reduce(
  (latest, post) => {
    const date = post.data.updatedDate ?? post.data.pubDate;
    return date > latest ? date : latest;
  },
  new Date(siteStartedAt),
);
const compactDate = [
  String(latestUpdate.getFullYear()).slice(-2),
  String(latestUpdate.getMonth() + 1).padStart(2, "0"),
  String(latestUpdate.getDate()).padStart(2, "0"),
].join(".");
const tagCount = getAllTags(posts).length;

const siteStats = [
  { label: "POSTS", value: posts.length, description: `${posts.length} 篇文章` },
  { label: "TAGS", value: tagCount, description: `${tagCount} 个标签` },
  { label: "DAYS", value: daysOnline, description: `建站第 ${daysOnline} 天` },
  { label: "UPDATED", value: compactDate, description: `最近更新于 ${compactDate}` },
];
---

<footer class="site-footer">
  <div class="footer-stats" aria-label="站点数据">
    <p class="footer-title">SITE DATA</p>
    <dl class="site-stats">
      {
        siteStats.map(({ label, value, description }) => (
          <div aria-label={description}>
            <dt>{label}</dt>
            <dd data-days-online={label === "DAYS" ? siteStartedOn : undefined}>{value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
  <div class="footer-links">
    <p class="footer-title">快速导航</p>
    <a href="/">首页</a>
    <a href="/posts/">文章</a>
    <a href="/tags/">标签</a>
  </div>
  <div class="footer-follow">
    <p class="footer-title">关注</p>
    <nav class="footer-social" aria-label="页脚链接">
      {
        socialLinks.map(({ href, label, icon: Icon, external }) => (
          <a
            href={href}
            aria-label={label}
            title={label}
            target={external ? "_blank" : undefined}
            rel={external ? "noreferrer" : undefined}
          >
            <Icon class="icon-muted" size={17} stroke-width={1.5} />
          </a>
        ))
      }
    </nav>
  </div>
  <blockquote>
    总觉得盛夏应该发生点什么热烈的事，每次想来却也只不过是些闷热的日子。
  </blockquote>
  <div class="footer-bottom">
    <span>© {new Date().getFullYear()} Akisy. All rights reserved.</span>
    <span>Built with Astro</span>
  </div>
</footer>

<script>
  const dayInMilliseconds = 86_400_000;
  const shanghaiDate = new Intl.DateTimeFormat("en", {
    timeZone: "Asia/Shanghai",
    year: "numeric",
    month: "numeric",
    day: "numeric",
  });

  const getShanghaiDay = (date: Date) => {
    const parts = Object.fromEntries(
      shanghaiDate
        .formatToParts(date)
        .filter(({ type }) => type !== "literal")
        .map(({ type, value }) => [type, Number(value)]),
    );

    return Date.UTC(parts.year, parts.month - 1, parts.day) / dayInMilliseconds;
  };

  const syncDaysOnline = () => {
    document.querySelectorAll<HTMLElement>("[data-days-online]").forEach((element) => {
      const [year, month, day] = (element.dataset.daysOnline ?? "").split("-").map(Number);
      if (!year || !month || !day) return;

      const startedOn = Date.UTC(year, month - 1, day) / dayInMilliseconds;
      const daysOnline = Math.max(1, Math.floor(getShanghaiDay(new Date()) - startedOn) + 1);
      element.textContent = String(daysOnline);
      element.parentElement?.setAttribute("aria-label", `建站第 ${daysOnline} 天`);
    });
  };

  const timerWindow = window as Window & { __akisySiteDayTimer?: number };
  if (timerWindow.__akisySiteDayTimer) window.clearInterval(timerWindow.__akisySiteDayTimer);
  timerWindow.__akisySiteDayTimer = window.setInterval(syncDaysOnline, 60_000);

  document.addEventListener("astro:page-load", syncDaysOnline);
  syncDaysOnline();
</script>
