</style>

<script>
  const metroChannels = [
    { id: "city" },
    { id: "coast" },
    { id: "rain" },
    { id: "snow" },
  ] as const;
  type MetroTransition = "fault" | "glitch" | "none";
  const metroTransitions: Exclude<MetroTransition, "none">[] = ["fault", "glitch"];
  const randomMetroTransition = () =>
    metroTransitions[Math.floor(Math.random() * metroTransitions.length)];

  const setupMetroChannels = () => {
    document.querySelectorAll<HTMLElement>("[data-metro-scene]").forEach((scene) => {
      if (scene.dataset.channelBound === "true") return;
      scene.dataset.channelBound = "true";

      const control = document.querySelector<HTMLElement>("[data-metro-controller]")!;
      const buttons = control.querySelectorAll<HTMLButtonElement>("[data-channel-id]");
      const randomButton = control.querySelector<HTMLButtonElement>("[data-random-channel]")!;
      const motionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
      let activeIndex = Math.floor(Math.random() * metroChannels.length);
      let channelTimer = 0;
      let transitionResetTimer = 0;

      const staticCanvas = scene.querySelector<HTMLCanvasElement>("[data-metro-static]");
      const staticContext = staticCanvas?.getContext("2d", { alpha: false });
      let staticFrame = 0;

      const stopStatic = () => {
        window.cancelAnimationFrame(staticFrame);
        staticFrame = 0;
      };

      const startStatic = () => {
        if (!staticCanvas || !staticContext) return;
        // Render at half resolution for fine, crisp analogue grain with bounded cost.
        staticCanvas.width = Math.max(1, Math.min(640, Math.round(staticCanvas.clientWidth / 2)));
        staticCanvas.height = Math.max(1, Math.round(staticCanvas.clientHeight / 2));
        const { width, height } = staticCanvas;
        const frame = staticContext.createImageData(width, height);
        const started = performance.now();
        let lastPaint = -Infinity;
        const draw = (now: number) => {
          if (now - started >= 620 || motionQuery.matches || document.hidden) {
            stopStatic();
            return;
          }
          // 25fps gives the grain an analogue texture without high-frequency flashes.
          if (now - lastPaint >= 40) {
            lastPaint = now;
            const trackingY = ((now - started) / 620) * (height + 28) - 14;
            for (let y = 0; y < height; y++) {
              const tracking = Math.max(0, 1 - Math.abs(y - trackingY) / 9);
              const rowBias = (Math.random() - 0.5) * 22 - tracking * 38;
              for (let x = 0; x < width; x++) {
                const offset = (y * width + x) * 4;
                const grain = 32 + Math.random() * 158 + rowBias;
                frame.data[offset] = grain;
                frame.data[offset + 1] = grain + 3;
                frame.data[offset + 2] = grain + 5;
                frame.data[offset + 3] = 255;
              }
            }
            staticContext.putImageData(frame, 0, 0);
          }
          staticFrame = window.requestAnimationFrame(draw);
        };
        draw(started);
      };

      const renderChannel = (index: number, transition: MetroTransition = "fault") => {
        activeIndex = (index + metroChannels.length) % metroChannels.length;
        const channel = metroChannels[activeIndex];
        const animateTransition = transition !== "none" && !motionQuery.matches;
        const transitionClass = transition === "glitch" ? "is-glitching" : "is-faulting";
        const switchDelay = transition === "glitch" ? 280 : 420;
        const resetDelay = transition === "glitch" ? 640 : 840;

        stopStatic();
        window.clearTimeout(transitionResetTimer);
        scene.classList.remove("is-faulting", "is-glitching");
        if (animateTransition) {
          void scene.offsetWidth;
          scene.classList.add(transitionClass);
          if (transition === "glitch") startStatic();
          transitionResetTimer = window.setTimeout(() => {
            scene.classList.remove(transitionClass);
          }, resetDelay);
        }

        window.clearTimeout(channelTimer);
        channelTimer = window.setTimeout(() => {
          scene.dataset.channel = channel.id;
          buttons.forEach((button) => {
            const selected = button.dataset.channelId === channel.id;
            button.setAttribute("aria-pressed", String(selected));
          });
        }, animateTransition ? switchDelay : 0);
      };

      buttons.forEach((button) => {
        button.addEventListener("click", () => {
          const nextIndex = metroChannels.findIndex(({ id }) => id === button.dataset.channelId);
          if (nextIndex >= 0 && nextIndex !== activeIndex) {
            renderChannel(nextIndex, randomMetroTransition());
          }
        });
      });

      randomButton.addEventListener("click", () => {
        const offset = 1 + Math.floor(Math.random() * (metroChannels.length - 1));
        renderChannel(activeIndex + offset, randomMetroTransition());
      });

      document.addEventListener(
        "astro:before-swap",
        () => {
          stopStatic();
          window.clearTimeout(channelTimer);
          window.clearTimeout(transitionResetTimer);
        },
        { once: true },
      );

      renderChannel(activeIndex, "none");
    });
  };

  const setupMetroRain = () => {
    document.querySelectorAll<HTMLElement>("[data-metro-scene]").forEach((scene) => {
      const canvas = scene.querySelector<HTMLCanvasElement>("[data-metro-rain]");
      if (!canvas || canvas.dataset.rainBound === "true") return;

      const context = canvas.getContext("2d", { alpha: true });
      if (!context) return;

      canvas.dataset.rainBound = "true";
      const motionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
      const colors = [
        "rgb(142 198 232 / 30%)",
        "rgb(183 211 235 / 24%)",
        "rgb(102 159 207 / 20%)",
      ];
      let seed = 0x1228;
      let drops: Array<{
        x: number;
        y: number;
        length: number;
        width: number;
        speed: number;
        drift: number;
        color: string;
      }> = [];
      let animationFrame = 0;
      let lastFrame = 0;
      let disposed = false;

      const random = () => {
        seed = (seed * 1664525 + 1013904223) >>> 0;
        return seed / 4294967296;
      };

      const resetDrop = (drop: (typeof drops)[number], initial = false) => {
        const layer = Math.min(2, Math.floor(random() * 3));
        drop.x = random() * canvas.width;
        drop.y = initial ? random() * canvas.height : -4 - random() * canvas.height * 0.45;
        drop.length = 4 + layer * 2 + Math.floor(random() * 4);
        drop.width = layer === 2 && random() > 0.82 ? 2 : 1;
        drop.speed = 2.2 + layer * 1.65 + random() * 1.3;
        drop.drift = -0.2 - layer * 0.16;
        drop.color = colors[layer];
        return drop;
      };

      const resizeRain = () => {
        const width = Math.max(1, Math.round(canvas.clientWidth));
        const height = Math.max(1, Math.round(canvas.clientHeight));
        if (canvas.width === width && canvas.height === height) return;

        canvas.width = width;
        canvas.height = height;
        const dropCount = Math.max(44, Math.min(92, Math.round((width * height) / 560)));
        drops = Array.from({ length: dropCount }, () =>
          resetDrop({ x: 0, y: 0, length: 0, width: 1, speed: 0, drift: 0, color: colors[0] }, true),
        );
      };

      const drawRain = (advance = true) => {
        context.clearRect(0, 0, canvas.width, canvas.height);
        context.globalCompositeOperation = "screen";
        context.imageSmoothingEnabled = false;

        drops.forEach((drop) => {
          context.fillStyle = drop.color;
          for (let offset = 0; offset < drop.length; offset += 2) {
            context.fillRect(
              Math.round(drop.x - offset * 0.18),
              Math.round(drop.y + offset),
              drop.width,
              Math.min(2, drop.length - offset),
            );
          }

          if (!advance) return;
          drop.x += drop.drift;
          drop.y += drop.speed;
          if (drop.y > canvas.height + drop.length) resetDrop(drop);
        });
      };

      const shouldAnimate = () =>
        !disposed &&
        !motionQuery.matches &&
        !document.hidden &&
        scene.dataset.channel === "rain";

      const animate = (timestamp: number) => {
        animationFrame = 0;
        if (!shouldAnimate()) return;

        if (timestamp - lastFrame >= 50) {
          lastFrame = timestamp - ((timestamp - lastFrame) % 50);
          drawRain(true);
        }
        animationFrame = window.requestAnimationFrame(animate);
      };

      const stop = () => {
        window.cancelAnimationFrame(animationFrame);
        animationFrame = 0;
      };

      const sync = () => {
        resizeRain();
        stop();
        if (shouldAnimate()) {
          lastFrame = 0;
          animationFrame = window.requestAnimationFrame(animate);
        } else {
          drawRain(false);
        }
      };

      const channelObserver = new MutationObserver(sync);
      const resizeObserver = new ResizeObserver(sync);
      channelObserver.observe(scene, { attributes: true, attributeFilter: ["data-channel"] });
      resizeObserver.observe(canvas);
      motionQuery.addEventListener("change", sync);
      document.addEventListener("visibilitychange", sync);

      document.addEventListener(
        "astro:before-swap",
        () => {
          disposed = true;
          stop();
          channelObserver.disconnect();
          resizeObserver.disconnect();
          motionQuery.removeEventListener("change", sync);
          document.removeEventListener("visibilitychange", sync);
        },
        { once: true },
      );

      sync();
    });
  };

  document.addEventListener("astro:page-load", () => {
    setupMetroChannels();
    setupMetroRain();
  });
  setupMetroChannels();
  setupMetroRain();
</script>
