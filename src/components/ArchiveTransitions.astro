<script>
  import { navigate } from "astro:transitions/client";

  /*
   * Opening a post lifts its folder out of the drawer, then the folder grows into
   * the record header through a shared view-transition name. Only one element may
   * hold the name at a time, so it is assigned per navigation.
   */
  const SHARED_NAME = "pulled-file";
  const LIFT_MS = 170;

  let returnPath = "/";
  let returningTo: string | undefined;
  let headWasOnScreen = true;

  const isRecord = (url: URL) => /^\/posts\/[^/]+/.test(url.pathname);
  const prefersReducedMotion = () => matchMedia("(prefers-reduced-motion: reduce)").matches;

  const clearSharedNames = () => {
    document.querySelectorAll<HTMLElement>("[data-memory]").forEach((file) => {
      file.style.removeProperty("view-transition-name");
    });
  };

  // Capture phase: this has to run before the client router's own click handler.
  document.addEventListener(
    "click",
    (event) => {
      if (event.defaultPrevented || event.button !== 0) return;
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

      const link = (event.target as Element).closest<HTMLAnchorElement>("a[data-file-link]");
      const file = link?.closest<HTMLElement>("[data-memory]");
      if (!link || !file) return;

      event.preventDefault();

      // One folder at a time: navigating again would throw away the download under way.
      // The mark goes away with the page, so this can't outlive the navigation.
      if (document.querySelector("[data-pulling]")) return;

      clearSharedNames();
      file.style.setProperty("view-transition-name", SHARED_NAME);
      file.toggleAttribute("data-pulling", true);

      if (prefersReducedMotion()) {
        navigate(link.href);
        return;
      }

      window.setTimeout(() => navigate(link.href), LIFT_MS);
    },
    { capture: true },
  );

  // A page restored from the back/forward cache keeps its marks, but nothing is loading any more.
  window.addEventListener("pageshow", (event) => {
    if (!event.persisted) return;
    clearSharedNames();
    document.querySelectorAll("[data-pulling]").forEach((file) => file.removeAttribute("data-pulling"));
  });

  // Runs before the old snapshot. A header scrolled far off screen would otherwise
  // fly in across the whole page, so reading to the end simply fades back instead.
  document.addEventListener("astro:before-preparation", () => {
    const head = document.querySelector<HTMLElement>(".record-head");
    headWasOnScreen = !head || head.getBoundingClientRect().bottom > 0;
    if (!headWasOnScreen) head?.style.setProperty("view-transition-name", "none");
  });

  document.addEventListener("astro:before-swap", (event) => {
    const { from, to, newDocument, viewTransition } = event;
    const leavingRecord = isRecord(from);

    newDocument.documentElement.dataset.turn = isRecord(to) ? "pull" : leavingRecord ? "return" : "plain";

    if (isRecord(to) && !leavingRecord) returnPath = from.pathname;

    returningTo = undefined;
    if (leavingRecord && !isRecord(to)) {
      const number = document.querySelector<HTMLElement>("[data-record-number]")?.dataset.recordNumber;
      const file = newDocument.querySelector<HTMLElement>(`[data-memory="${number}"]`);
      if (file) {
        if (headWasOnScreen) file.style.setProperty("view-transition-name", SHARED_NAME);
        returningTo = number;
      }
    }

    viewTransition.finished.finally(clearSharedNames);
  });

  // Runs before the new snapshot, so the folder is on screen for the sheet to return to.
  document.addEventListener("astro:after-swap", () => {
    if (!returningTo) return;
    document
      .querySelector(`[data-memory="${returningTo}"]`)
      ?.scrollIntoView({ block: "nearest", inline: "center", behavior: "instant" });
  });

  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll("[data-return-link]").forEach((link) => link.setAttribute("href", returnPath));
  });
</script>
