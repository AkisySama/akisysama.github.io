---
const navItems = [
  { href: "/posts/", label: "目录" },
  { href: "/about/", label: "关于" },
];

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <a class="brand" href="/">Akisy</a>
  <nav class="site-nav" aria-label="主导航">
    {
      navItems.map((item) => (
        <a href={item.href} aria-current={currentPath.startsWith(item.href) ? "page" : undefined}>
          {item.label}
        </a>
      ))
    }
    <button
      type="button"
      aria-controls="timeline-drawer"
      aria-expanded="false"
      aria-label="打开生活动态"
      data-timeline-toggle
    >
      动态
    </button>
  </nav>
</header>
